<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JERS ENTERPRISE</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #F4F4F4;
            text-align: center;
            color: #333;
        }
        header {
            background-color: #0A3D62;
            padding: 20px;
        }
        header img {
            width: 200px;
            max-width: 80%;
        }
        h1 {
            color: #fff;
            margin: 10px 0 0 0;
            font-size: 28px;
        }
        .socials {
            margin: 20px 0;
        }
        .socials a {
            text-decoration: none;
            margin: 0 10px;
            display: inline-block;
        }
        .socials img {
            width: 40px;
            height: 40px;
            transition: transform 0.3s;
        }
        .socials img:hover {
            transform: scale(1.2);
        }
        .simulador {
            margin: 30px auto;
            width: 90%;
            max-width: 800px;
            height: 500px;
            border: 2px solid #0A3D62;
            border-radius: 10px;
            overflow: hidden;
        }
        footer {
            margin-top: 40px;
            padding: 20px;
            background-color: #0A3D62;
            color: #fff;
        }
        @media (max-width: 600px) {
            .simulador {
                height: 400px;
            }
        }
    </style>
</head>
<body>
    <header>
        <!-- Logo de JERS ENTERPRISE -->
        <img src="ruta_de_tu_logo.png" alt="JERS ENTERPRISE Logo">
        <h1>Dedicado a la Gestión de Inversiones</h1>
    </header>

    <!-- Redes sociales -->
    <div class="socials">
        <a href="https://wa.me/tu_numero" target="_blank">
            <img src="https://cdn-icons-png.flaticon.com/512/733/733585.png" alt="WhatsApp">
        </a>
        <a href="https://www.instagram.com/tu_usuario" target="_blank">
            <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram">
        </a>
        <a href="https://www.facebook.com/tu_usuario" target="_blank">
            <img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook">
        </a>
        <a href="https://www.linkedin.com/in/tu_usuario" target="_blank">
            <img src="https://cdn-icons-png.flaticon.com/512/174/174857.png" alt="LinkedIn">
        </a>
    </div>

    <!-- Simulador de inversiones -->
    <div class="simulador">
        <iframe src="https://tu-simulador.com" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>
    </div>

    <footer>
        © 2026 JERS ENTERPRISE - Todos los derechos reservados
    </footer>
</body>
</html>
